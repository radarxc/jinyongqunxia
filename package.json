{
  "name": "tianshu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/game dev",
    "build": "pnpm --filter ./apps/game build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run --config vitest.workspace.ts",
    "content:validate": "node packages/data/scripts/validate-content.mjs",
    "size": "pnpm build && node tools/perf/check_size.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm content:validate && pnpm size",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "@vue/devtools-api": "8.2.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
