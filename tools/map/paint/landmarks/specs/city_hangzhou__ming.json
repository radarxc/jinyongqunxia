   "supports": "唐称白沙堤，东起断桥、西止平湖秋月（孤山）"
  },
  "src_baochu": {
   "title": "维基百科（中文）《保俶塔》",
   "url": "https://zh.wikipedia.org/wiki/%E4%BF%9D%E4%BF%B6%E5%A1%94",
   "accessed": "2026-10-11",
   "supports": "西湖北岸宝石山顶，吴越开宝年间（968–976）始建，屡毁屡建，明万历七年（1579）重修为七层"
  },
  "src_hz_wall": {
   "title": "维基百科（中文）《杭州城墙》",
   "url": "https://zh.wikipedia.org/wiki/%E6%9D%AD%E5%B7%9E%E5%9F%8E%E5%A2%99",
   "accessed": "2026-10-11",
   "supports": "南宋城墙范围（北环城北路、西西湖东岸与凤凰山西麓、南将台山、东东河）与 13 门；元末张士诚 1359 年重筑：南界缩至万松岭（凤凰山截在城外）、东界外扩至贴沙河；明代十门；顺治年间城内西侧建八旗驻防城"
  },
  "src_leifeng": {
   "title": "维基百科（中文）《雷峰塔》",
   "url": "https://zh.wikipedia.org/wiki/%E9%9B%B7%E5%B3%B0%E5%A1%94",
   "accessed": "2026-10-11",
   "supports": "吴越 972–977 年建于西湖南岸夕照山；南宋重修为五层；明嘉靖年间倭寇纵火，木檐尽毁仅存砖身；1924 年倒塌"
  },
  "src_linan": {
   "title": "维基百科（中文）《临安城》",
   "url": "https://zh.wikipedia.org/wiki/%E4%B8%B4%E5%AE%89%E5%9F%8E",
   "accessed": "2026-10-11",
   "supports": "南宋都城；南宫北市：宫殿在南部凤凰山，御街自和宁门北行约 4.5 km；皇城方圆九里；外城南跨吴山、北至武林门、西接西湖（湖在城外）、东临钱塘江；城内四条河道（盐桥河为主）"
  },
  "src_liuhe": {
   "title": "维基百科（中文）《六和塔》",
   "url": "https://zh.wikipedia.org/wiki/%E5%85%AD%E5%92%8C%E5%A1%94",
   "accessed": "2026-10-11",
   "supports": "970 年建于钱塘江畔月轮山；1121 年毁，南宋 1153–1163 年重建七层；嘉靖十二年（1533）外檐被焚，雍正十三年（1735）重建外檐"
  },
  "src_sudi": {
   "title": "维基百科（中文）《苏堤》",
   "url": "https://zh.wikipedia.org/wiki/%E8%8B%8F%E5%A0%A4",
   "accessed": "2026-10-11",
   "supports": "元祐四年（1089）苏轼疏浚西湖筑长堤，堤上六桥"
  }
 },
