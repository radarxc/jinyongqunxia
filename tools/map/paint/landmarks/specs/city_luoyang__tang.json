 "notes": [
  "天堂 695 年与明堂同焚；《资治通鉴》载命更造而《旧唐书·礼仪志》只载明堂重建成通天宫（696），未见天堂建成——702 档不画天堂（宁缺勿滥）",
  "702 年神都仍为正式都城（武则天 701–703 年驻长安）；唐代无专用套件，以 song_north 代用",
  "ch10 地图名录仍为清初「河南府」，本图按 AR-26 画武周神都",
  "宫城、皇城、东城与含嘉仓的相对位置为拓扑示意；洛水走向示意",
  "交付图比例约 74.2 px/km（城墙、门楼、街宽、胡同间距按交付图像素给定，见 *_px 字段）"
 ],
 "sources": {
  "src_jiutangshu22": {
   "title": "维基文库《舊唐書/卷22》",
   "url": "https://zh.wikisource.org/wiki/%E8%88%8A%E5%94%90%E6%9B%B8/%E5%8D%B722",
   "accessed": "2026-10-11",
   "supports": "则天于明堂后造天堂；证圣元年（695）正月佛堂（天堂）火延烧明堂，二堂并尽；寻令依旧规制重造明堂，天册万岁二年（696）三月成，号通天宫；九州鼎置明堂之庭（未载天堂重建建成）"
  },
  "src_luoyang_city": {
   "title": "维基百科（中文）《洛阳城》",
   "url": "https://zh.wikipedia.org/wiki/%E6%B4%9B%E9%98%B3%E5%9F%8E",
   "accessed": "2026-10-11",
   "supports": "隋唐洛阳城郭城正门定鼎门（隋建国门）为中轴线标志，沿用约 530 年"
  },
  "src_luoyang_site": {
   "title": "维基百科（中文）《隋唐洛阳城遗址》",
   "url": "https://zh.wikipedia.org/wiki/%E9%9A%8B%E5%94%90%E6%B4%9B%E9%98%B3%E5%9F%8E%E9%81%97%E5%9D%80",
   "accessed": "2026-10-11",
   "supports": "大业元年（605）兴建，宫城、皇城建于城西北最高处，郭城周长 27 km 余、南东各三门、北二门、西墙无门；沿用隋唐五代至北宋 500 余年，为北宋西京"
  },
  "src_mingtang_ly": {
   "title": "维基百科（中文）《明堂 (洛阳)》",
   "url": "https://zh.wikipedia.org/wiki/%E6%98%8E%E5%A0%82%20%28%E6%B4%9B%E9%98%B3%29",
   "accessed": "2026-10-11",
   "supports": "明堂 688 年建于紫微宫乾阳殿旧址，号万象神宫，为宫城核心建筑"
  },
  "src_tianshu": {
   "title": "维基百科（中文）《大周万国颂德天枢》",
   "url": "https://zh.wikipedia.org/wiki/%E5%A4%A7%E5%91%A8%E4%B8%87%E5%9B%BD%E9%A2%82%E5%BE%B7%E5%A4%A9%E6%9E%A2",
   "accessed": "2026-10-11",
   "supports": "延载元年（694）请立、天册万岁元年（695）四月成，立于端门之外中轴线上；八棱铜柱高一百五尺，下为铁山，上为腾云承露盘与火珠"
  },
  "src_ziwei": {
   "title": "维基百科（中文）《紫微宮 (洛陽)》",
   "url": "https://zh.wikipedia.org/wiki/%E7%B4%AB%E5%BE%AE%E5%AE%AE%20%28%E6%B4%9B%E9%99%BD%29",
   "accessed": "2026-10-11",
   "supports": "紫微宫为隋唐洛阳宫城，位于城西北部；武周时为国家统治中心，北宋时尚存，北宋末毁于战乱"
  },
  "src_zztj205": {
   "title": "维基文库《資治通鑑/卷205》",
   "url": "https://zh.wikisource.org/wiki/%E8%B3%87%E6%B2%BB%E9%80%9A%E9%91%91/%E5%8D%B7205",
   "accessed": "2026-10-11",
   "supports": "天枢（695 年四月成）高一百五尺、立于端门之外；明堂北构天堂，695 年焚毁后命更造明堂、天堂；696 年新明堂成，号通天宫"
  }
