 "sources": {
  "src_beihai": {
   "title": "维基百科（中文）《北海公园》",
   "url": "https://zh.wikipedia.org/wiki/%E5%8C%97%E6%B5%B7%E5%85%AC%E5%9B%AD",
   "accessed": "2026-10-11",
   "supports": "辽瑶屿行宫在辽南京东北郊；金大定十九年（1179）建大宁宫、广寒殿、琼华岛；元太液池、万寿山、团城；明永乐拓中海南海成西苑；1579 广寒殿倒塌；1651 建白塔"
  },
  "src_gugong": {
   "title": "维基百科（中文）《故宫》",
   "url": "https://zh.wikipedia.org/wiki/%E6%95%85%E5%AE%AB",
   "accessed": "2026-10-11",
   "supports": "紫禁城位置、三大殿居中轴、宫城四门与角楼"
  },
  "src_huangcheng": {
   "title": "维基百科（中文）《北京皇城》",
   "url": "https://zh.wikipedia.org/wiki/%E5%8C%97%E4%BA%AC%E7%9A%87%E5%9F%8E",
   "accessed": "2026-10-11",
   "supports": "明清皇城范围、天安门 / 地安门、西苑三海"
  },
  "src_miaoying": {
   "title": "维基百科（中文）《妙应寺》",
   "url": "https://zh.wikipedia.org/wiki/%E5%A6%99%E5%BA%94%E5%AF%BA",
   "accessed": "2026-10-11",
   "supports": "妙应寺白塔元至元八年（1271）敕建、十六年（1279）建成，位于元大都城内西部（阜成门内）"
  },
  "src_mqbj": {
   "title": "维基百科（中文）《明清北京城》",
   "url": "https://zh.wikipedia.org/wiki/%E6%98%8E%E6%B8%85%E5%8C%97%E4%BA%AC%E5%9F%8E",
   "accessed": "2026-10-11",
   "supports": "内城九门、四角楼、西北缺角；永乐南墙南移 800 m；嘉靖三十二年（1553）只筑南面外城成「凸」字形，外城七门、东南角内曲；清沿明制、内城为满城"
  },
  "src_shichahai": {
   "title": "维基百科（中文）《什刹海》",
   "url": "https://zh.wikipedia.org/wiki/%E4%BB%80%E5%88%B9%E6%B5%B7",
   "accessed": "2026-10-11",
   "supports": "元积水潭为大都规划依据，明清缩为什刹海三海"
  },
  "src_tiantan": {
   "title": "维基百科（中文）《天坛》",
   "url": "https://zh.wikipedia.org/wiki/%E5%A4%A9%E5%9D%9B",
   "accessed": "2026-10-11",
   "supports": "1420 天地坛（仿南京大祀坛）；1530 专祭天、建圜丘；1538 拆大祀殿、1545 建成大享殿（圆）；1751 改名祈年殿；外坛墙北圆南方"
  },
  "src_xiannong": {
   "title": "维基百科（中文）《先农坛》",
   "url": "https://zh.wikipedia.org/wiki/%E5%85%88%E5%86%9C%E5%9D%9B",
   "accessed": "2026-10-11",
   "supports": "1420 建山川坛于南郊，后为先农坛"
  },
  "src_yuandadu": {
   "title": "维基百科（中文）《元大都》",
   "url": "https://zh.wikipedia.org/wiki/%E5%85%83%E5%A4%A7%E9%83%BD",
   "accessed": "2026-10-11",
   "supports": "元大都东西 6.65 km、南北 7.4 km，十一门（南东西各三、北二）；皇城以太液池为中心，大内在东、隆福 / 兴圣宫在西；中心阁、钟鼓楼、积水潭；至正十九年（1359）十一门加瓮城；南墙西段因庆寿寺双塔外凸；胡同制"
  },
  "src_zhonggulou": {
   "title": "维基百科（中文）《北京鼓楼和钟楼》",
   "url": "https://zh.wikipedia.org/wiki/%E5%8C%97%E4%BA%AC%E9%BC%93%E6%A5%BC%E5%92%8C%E9%92%9F%E6%A5%BC",
   "accessed": "2026-10-11",
   "supports": "元至元九年（1272）建钟鼓楼；明永乐迁址，鼓楼在元中心阁旧址、钟楼在其北 100 m（元钟楼旧基）"
  }
 },
