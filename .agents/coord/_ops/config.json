 "fixes": [
  {
   "name": "content-plugin 5 秒功能用例超时",
   "patterns": [
    "content[-_]plugin",
    "(?:timed out in 5000ms|Test timed out.*5(?:000| seconds))"
   ],
   "commit": "d0c0c1fa",
   "task": "ENG-content-plugin-timeout"
  },
  {
   "name": "HOST_DISPOSED rejection",
   "patterns": [
    "HOST_DISPOSED"
   ],
   "task": "ENG-battle-lazy-dispose"
  },
  {
   "name": "BattleSession 线性计时断言挪出",
   "patterns": [
    "(?:BattleSession|core/bench|combat\\.test)",
    "(?:expected .* to be|linear|线性)"
   ],
   "task": "ENG-bench-perf-split"
  },
  {
   "name": "首次会话体积瘦身",
   "patterns": [
    "session total\\s+[0-9.]+\\s+110\\s+FAIL"
   ],
   "task": "ENG-session-base-diet"
  },
  {
   "name": "apps/game 功能用例 vi.waitFor 默认 1 秒超时（负载高时 app-flow 误报）",
   "patterns": [
    "apps/game/src/app-flow\\.test\\.ts",
    "accepts a second user command"
   ],
   "task": "ENG-waitfor-timeout"
  },
  {
   "name": "存储层 1 MiB 快照 50 ms 计时断言（负载高时误红）",
   "patterns": [
    "storage\\.test\\.ts",
    "1 MiB snapshot within the 50 ms"
   ],
   "task": "ENG-storage-perf-split"
  },
  {
   "name": "item-content ch10 真产物用例负载超时（15 s）",
   "patterns": [
    "item-content\\.test\\.ts",
    "loads the real compiled ch10 DTO"
   ],
   "task": "ENG-ch10-test-timeout"
  }
 ]
